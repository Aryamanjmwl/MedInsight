# Required in production. SQLAlchemy database URL; SQLite is the local default.
DATABASE_URL=sqlite:///backend/data/medinsight.db

# Required for authenticated endpoints. Used to derive issuer and JWKS endpoints.
SUPABASE_URL=https://your-project-ref.supabase.co
# Optional; defaults to authenticated.
SUPABASE_JWT_AUDIENCE=authenticated

# Required for browser clients in production. Comma-separated exact origins; no *.
MEDINSIGHT_CORS_ORIGINS=https://your-frontend.example.com

# Optional OCR executable override. Leave empty to resolve tesseract from PATH.
MEDINSIGHT_TESSERACT_CMD=

# Optional Groq AI explanation configuration. Keep the API key server-side only.
GROQ_API_KEY=
MEDINSIGHT_AI_MODEL=openai/gpt-oss-20b
