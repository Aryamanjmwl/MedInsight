# SQLAlchemy database URL. SQLite remains the local-development default.
DATABASE_URL=sqlite:///backend/data/medinsight.db

# Public Supabase project URL used to derive issuer and JWKS endpoints.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated

# Server-side secret only; never expose this through EXPO_PUBLIC_*.
OPENAI_API_KEY=
MEDINSIGHT_AI_MODEL=gpt-5.6
